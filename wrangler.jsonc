{
  "name": "claude-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentSession", "Sandbox"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["AgentSession", "Sandbox"]
    }
  ],

  "observability": { "enabled": true }
}
