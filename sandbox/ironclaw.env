# IronClaw config — model-agnostic, no crypto
# LLM backend is set per-session via environment variable from the platform
# Users provide their own API keys via the web UI

# Database: embedded libSQL (no external DB needed)
DATABASE_URL=file:///home/agent/.ironclaw/data.db

# Disable NEAR/crypto features
NEAR_ENABLED=false

# Security: WASM sandbox enabled
SANDBOX_ENABLED=true

# Persistence directory (mounted from R2 via FUSE)
IRONCLAW_DATA_DIR=/home/agent/persistent
